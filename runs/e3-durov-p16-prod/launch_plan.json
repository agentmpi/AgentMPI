  "executor": "broker",
  "worker_command": "ampi worker --campaign e3-durov-p16-prod --rank RANK --job-root /workspace/runs/e3-durov-p16-prod/job next --timeout 240",
  "lifecycle": {
    "task_timeout_s": 3600.0,
    "claim_ttl_s": 1200.0,
    "barrier_policy": "wait",
    "failure_policy": "retry-then-fail",
    "max_restarts": 2
  },
  "bounds": {
    "context_tokens_per_rank": 160000,
    "research_chars": 12000,
    "max_prompt_chars": 180000,
    "contracts": {
      "research": {
        "kind": "json",
        "name": "durov-research",
        "required": [
          "rank",
          "terminology",
          "proposals"
        ],
        "expect": {
          "rank": "{rank}"
        },
        "max_tokens": 2400,
        "semantics": "Cultural and terminology proposals, each supported by a URL and evidence."
      },
      "arbitration": {
        "kind": "json",
        "name": "durov-terminology-arbitration",
        "required": [
          "rank",
          "rulings",
          "reasons"
        ],
        "expect": {
          "rank": "{rank}"
        },
        "max_tokens": 5000,
        "semantics": "One evidence-grounded ruling for every lifted terminology conflict."
      },
      "translation": {
        "kind": "json",
        "name": "durov-translation",
        "required": [
          "rank",
          "pages"
        ],
        "nonempty": [
          "pages"
        ],
        "expect": {
          "rank": "{rank}"
        },
        "max_tokens": 12000,
        "semantics": "One complete literary English, Simplified Chinese, and Japanese page."
      },
      "review": {
        "kind": "json",
        "name": "durov-review",
        "required": [
          "rank",
          "target_rank",
          "critique",
          "revised_translation"
        ],
        "nonempty": [
          "critique",
          "revised_translation"
        ],
        "expect": {
          "rank": "{rank}"
        },
        "max_tokens": 14000,
        "semantics": "A substantive peer review and corrected translation of one page."
      }
    }
  },
