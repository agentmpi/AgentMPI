{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmpi.org/schema/0.2/envelope.json",
  "title": "AgentMPI 0.2 message envelope",
  "description": "Transport-neutral envelope for one AgentMPI run. Run identity and communicator context are never wildcardable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "message_id",
    "communicator_id",
    "source_rank",
    "destination_rank",
    "tag",
    "sequence",
    "delivery_mode",
    "estimated_tokens",
    "created_at"
  ],
  "properties": {
    "protocol_version": { "const": "0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "message_id": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "communicator_id": { "type": "string", "minLength": 1 },
    "source_rank": { "type": "integer", "minimum": 0 },
    "source_generation": { "type": "integer", "minimum": 0 },
    "source_incarnation": { "type": "integer", "minimum": 0 },
    "destination_rank": { "type": "integer", "minimum": 0 },
    "tag": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 1 },
    "delivery_mode": { "enum": ["eager", "rendezvous", "synchronous"] },
    "body": { "$ref": "#/$defs/jsonValue" },
    "artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "digest": { "type": ["string", "null"] },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": ["string", "null"] },
    "causation_id": { "type": ["string", "null"] },
    "idempotency_key": { "type": ["string", "null"] },
    "deadline": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "extensions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  },
  "oneOf": [
    {
      "required": ["body"],
      "not": { "required": ["artifact_ref"] }
    },
    {
      "required": ["artifact_ref"],
      "not": { "required": ["body"] }
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "sha256", "estimated_tokens"],
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string" },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "digest": { "type": ["string", "null"] }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
