{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmpi.org/schema/0.1/envelope.json",
  "title": "AgentMPI 0.1 transport envelope",
  "description": "Canonical production wire envelope. The SQLite reference runtime persists the semantic subset documented in SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "session_id",
    "communicator_id",
    "generation",
    "source_rank",
    "source_incarnation",
    "destination_rank",
    "tag",
    "sequence",
    "delivery_mode",
    "content_type",
    "payload_bytes",
    "estimated_tokens",
    "checksum",
    "created_at"
  ],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "message_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "communicator_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "source_rank": { "type": "integer", "minimum": 0 },
    "source_incarnation": { "type": "integer", "minimum": 0 },
    "destination_rank": { "type": "integer", "minimum": 0 },
    "tag": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "delivery_mode": {
      "enum": ["standard", "synchronous", "buffered", "ready"]
    },
    "content_type": { "type": "string", "minLength": 1 },
    "schema_id": { "type": ["string", "null"] },
    "payload_inline": { "$ref": "#/$defs/jsonValue" },
    "artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "payload_bytes": { "type": "integer", "minimum": 0 },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "deadline": { "type": ["string", "null"], "format": "date-time" },
    "trace_context": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "capability_proof": { "type": ["string", "null"] },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "required": ["payload_inline"],
      "not": { "required": ["artifact_ref"] }
    },
    {
      "required": ["artifact_ref"],
      "not": { "required": ["payload_inline"] }
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type", "size_bytes", "estimated_tokens", "summary"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string", "maxLength": 2048 }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
