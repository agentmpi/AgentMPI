__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.review/
build/
dist/

# LaTeX intermediates.  The built PDF is checked in deliberately (see
# scripts/check_pdf.py, which verifies it matches the sources), but nothing else.
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.run.xml

# Live job state.  Runs that back a claim in the paper are committed under
# runs/ deliberately; scratch jobs are not.
scratch/
/tmp-jobs/
node_modules/
viewer/dist/

# A live job's directory is never tracked.  Its write-ahead log can reach hundreds
# of megabytes, and git cannot even hash a file a running population is writing
# ("unstable object source data").  scripts/seal_run.py checkpoints the journal
# into a single file under runs/<name>/evidence/ once the run is over; that is
# what gets committed, and it is what the paper's numbers are recomputed from.
runs/*/job/
*.db-wal
*.db-shm
agentmpi.egg-info/
work/

# The hub's shared token, written by `fleet.py env` beside the run it belongs
# to.  The run's evidence is committed; its credential never is.
runs/*/hub_token
