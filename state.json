onventions":["Dialogue dashes: render Russian em-dash dialogue as English double quotes, Chinese \u201c\u201d and Japanese \u300c\u300d; never keep the dash in the target text. [rank 1]","Names: keep name+patronymic where the Russian has it, one fixed transliteration per language (en Library-of-Congress style without diacritics, zh standard \u65b0\u534e\u793e transliteration, ja katakana with \u30fb separators); no honorifics added in Japanese for narration. [rank 1]","\u0442\u044b/\u0432\u044b: Vorobyaninov addresses Bezenchuk as \u0442\u044b and is addressed as \u0432\u044b; render in Japanese as plain form vs \u3067\u3059\u30fb\u307e\u3059, in Chinese as \u4f60 vs \u60a8, and in English through tone rather than pronouns. [rank 1]"],"chapter_titles":{},"writers":[1]},"writer":1,"epoch":1,"ts":1788421749.5471172,"meta":{"tokens":177,"summary":"object with keys [conventions, chapter_titles, writers]"}}]},"locks":{},"fence":{"win/b4b44eaeff87/world/0/registry\tregistry":1},"obj":{"dacee6ed05220dde957891f62b59f8a0":"{\"arm\":\"full\",\"author\":\"\u0418\u043b\u044c\u044f \u0418\u043b\u044c\u0444 \u0438 \u0415\u0432\u0433\u0435\u043d\u0438\u0439 \u041f\u0435\u0442\u0440\u043e\u0432\",\"book\":\"\u0414\u0432\u0435\u043d\u0430\u0434\u0446\u0430\u0442\u044c \u0441\u0442\u0443\u043b\u044c\u0435\u0432\",\"corpus\":\"chairs\",\"digests\":{\"1\":\"98aaf40aeb3000a7\",\"2\":\"4b83b15a1a06b375\",\"3\":\"90a3312890ae48dc\",\"4\":\"037247aa7dec25d2\",\"5\":\"cdcf291fe5240cd9\",\"6\":\"34ceef608db29485\",\"7\":\"49233af3d9987ec8\",\"8\":\"f20c056ab45766e9\"},\"languages\":[\"en\",\"zh\",\"ja\"],\"rules\":[\"the binding glossary overrides local preference\",\"translate every sentence; never summarise\",\"one JSON file per page in the legacy schema\"],\"segments\":[[1,2],[3,4],[5,6],[7,8]],\"source_commit\":\"d3fc77edc6bff08e\"}","00fd4dc32a222df5ac910e45e89b91f6":"[{\"pages\":[1,2],\"rank\":0},{\"pages\":[3,4],\"rank\":1},{\"pages\":[5,6],\"rank\":2},{\"pages\":[7,8],\"rank\":3}]","ac9baf7e8b12bbc89199717f7290dcce":"{\"\u00ab\u041c\u0438\u043b\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0441\u0438\u043c\u00bb\":{\"en\":\"the Welcome\",\"ja\":\"\u300c\u3088\u3046\u3053\u305d\u300d\u846c\u5100\u793e\",\"zh\":\"\u201c\u6b22\u8fce\u5149\u4e34\u201d\u6ba1\u846c\u793e\"},\"\u00ab\u041d\u0438\u043c\u0444\u0430\u00bb\":{\"en\":\"the Nymph\",\"ja\":\"\u846c\u5100\u793e\u300c\u30cb\u30f3\u30d5\u300d\",\"zh\":\"\u201c\u5b81\u8299\u201d\u6ba1\u846c\u793e\uff08\u4e09\u4e2a\u201c\u5b81\u8299\u201d\uff09\"},\"\u00ab\u0421\u0434\u0435\u043b\u0430\u043b \u0441\u0432\u043e\u0435 \u0434\u0435\u043b\u043e \u2014 \u0438 \u0443\u0445\u043e\u0434\u0438\u00bb\":{\"en\":\"Finished Your Business? Then Leave.\",\"ja\":\"\u300c\u7528\u304c\u6e08\u3093\u3060\u3089\u304a\u5e30\u308a\u304f\u3060\u3055\u3044\u300d\",\"zh\":\"\u201c\u529e\u5b8c\u4e8b\u5c31\u8d70\u201d\"},\"\u0411\u0435\u0437\u0435\u043d\u0447\u0443\u043a\":{\"en\":\"Bezenchuk\",\"ja\":\"\u30d9\u30bc\u30f3\u30c1\u30e5\u30af\",\"zh\":\"\u522b\u6d25\u4e18\u514b\"},\"\u0417\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0442\u0430\u0438\u043d\u0441\u0442\u0432\u0430\":{\"en\":\"For the performance of the sacrament\",\"ja\":\"\u300c\u79d8\u8de1\u57f7\u884c\u6599\u3068\u3057\u3066\u300d\",\"zh\":\"\u201c\u5723\u793c\u624b\u7eed\u8d39\u201d\"},\"\u0418\u043f\u043f\u043e\u043b\u0438\u0442 \u041c\u0430\u0442\u0432\u0435\u0435\u0432\u0438\u0447\":{\"en\":\"Ippolit Matveyevich\",\"ja\":\"\u30a4\u30c3\u30dd\u30ea\u30fc\u30c8\u30fb\u30de\u30c8\u30f4\u30a7\u30fc\u30a8\u30f4\u30a3\u30c1\",\"zh\":\"\u4f0a\u6ce2\u5229\u7279\u00b7\u9a6c\u7279\u7ef4\u8036\u7ef4\u5947\"},\"\u041c\u0430\u0446\u0438\u0441\u0442\":{\"en\":\"Maciste\",\"ja\":\"\u30de\u30c1\u30b9\u30c6\",\"zh\":\"\u9a6c\u5947\u65af\u7279\"},\"\u0421\u043e\u0447\u0435\u0442\u0430\u0442\u044c\u0441\u044f!\":{\"en\":\"Matrimony!\",\"ja\":\"\u300c\u7d50\u5a5a\u3067\u3059\uff01\u300d\",\"zh\":\"\u201c\u7ed3\u5a5a\u767b\u8bb0\uff01\u201d\"},\"\u0421\u0442\u0430\u0440\u043e\u043f\u0430\u043d\u0441\u043a\u0430\u044f \u043f\u043b\u043e\u0449\u0430\u0434\u044c\":{\"en\":\"Staropanskaya Square\",\"ja\":\"\u30b9\u30bf\u30ed\u30d1\u30f3\u30b9\u30ab\u30e4\u5e83\u5834\",\"zh\":\"\u65af\u5854\u7f57\u6f58\u65af\u5361\u4e9a\u5e7f\u573a\"},\"\u0422\u0432\u0435\u0440\u044c\":{\"en\":\"Tver\",\"ja\":\"\u30c8\u30f4\u30a7\u30ea\",\"zh\":\"\u7279\u7ef4\u5c14\"},\"\u0433\u043b\u0430\u0437\u0435\u0442\":{\"en\":\"silver brocade\",\"ja\":\"\u9280\u8974\",\"zh\":\"\u94f6\u7ebf\u9526\u7f0e\"},\"\u0433\u0440\u043e\u0431 \u2014 \u043e\u0433\u0443\u0440\u0447\u0438\u043a, \u043e\u0442\u0431\u043e\u0440\u043d\u044b\u0439, \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439\":{\"en\":\"a coffin like a pickle \u2014 choice, connoisseur grade\",\"ja\":\"\u3046\u3061\u306e\u68fa\u6876\u306f\u304d\u3085\u3046\u308a\u306e\u3088\u3046\u306b\u745e\u3005\u3057\u3044\u3001\u9078\u308a\u3059\u3050\u308a\u306e\u9038\u54c1\",\"zh\":\"\u6211\u7684\u68fa\u6750\u50cf\u814c\u9ec4\u74dc\u4e00\u6837\u2014\u2014\u7cbe\u9009\u8d27\uff0c\u884c\u5bb6\u7ea7\"},\"\u0433\u0440\u043e\u0431\u043e\u0432\u044b\u0445 \u0434\u0435\u043b \u043c\u0430\u0441\u0442\u0435\u0440\":{\"en\":\"master coffin-maker\",\"ja\":\"\u68fa\u6876\u8077\u4eba\u306e\u89aa\u65b9\",\"zh\":\"\u68fa\u6750\u5320\u5e08\u5085\"},\"\u043a\u0430\u043a \u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u044c \u0440\u0430\u043d\u044c\u0448\u0435, \u0441 \u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c \u0431\u0440\u0430\u043a\u043e\u043c\":{\"en\":\"as we used to say in the old days, on your lawful wedlock\",\"ja\":\"\u6614\u98a8\u306b\u7533\u305b\u3070\u3001\u6b63\u5f0f\u306a\u308b\u3054\u7d50\u5a5a\u3092\",\"zh\":\"\u6309\u65e7\u65f6\u7684\u8bf4\u6cd5\uff0c\u606d\u8d3a\u4f60\u4eec\u5408\u6cd5\u7ed3\u4e3a\u592b\u5987\"},\"\u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432 \u00ab\u041f\u043b\u0443\u0433 \u0438 \u043c\u043e\u043b\u043e\u0442\u00bb\":{\"en\":\"the Plough and Hammer cooperative\",\"ja\":\"\u5354\u540c\u7d44\u5408\u300c\u92e4\u3068\u69cc\u300d\",\"zh\":\"\u201c\u7281\u4e0e\u9524\u201d\u5408\u4f5c\u793e\"},\"\u043f\u0435\u043d\u0441\u043d\u0435\":{\"en\":\"pince-nez\",\"ja\":\"\u9f3b\u773c\u93e1\",\"zh\":\"\u5939\u9f3b\u773c\u955c\"},\"\u0441\u043a\u043e\u0440\u043e\u0441\u0448\u0438\u0432\u0430\u0442\u0435\u043b\u044c \u2116 2\":{\"en\":\"file folder No. 2\",\"ja\":\"\u7b2c2\u53f7\u7db4\u3058\u8fbc\u307f\u30d5\u30a1\u30a4\u30eb\",\"zh\":\"2\u53f7\u6587\u4ef6\u5939\"},\"\u0441\u043e\u0432\u0435\u0442\u0441\u043a\u0438\u0439 \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u0439\":{\"en\":\"Soviet office clerk\",\"ja\":\"\u30bd\u30f4\u30a3\u30a8\u30c8\u5b98\u5e81\u8077\u54e1\",\"zh\":\"\u82cf\u7ef4\u57c3\u673a\u5173\u804c\u5458\"},\"\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0448\u0442\u0430\u0442\u0430\":{\"en\":\"staff cuts\",\"ja\":\"\u4eba\u54e1\u6574\u7406\",\"zh\":\"\u88c1\u51cf\u7f16\u5236\"},\"\u0441\u0442\u043e\u043b \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u0438 \u0431\u0440\u0430\u043a\u043e\u0432\":{\"en\":\"the desk for registering deaths and marriages\",\"ja\":\"\u6b7b\u4ea1\u30fb\u5a5a\u59fb\u767b\u9332\u7a93\u53e3\",\"zh\":\"\u6b7b\u4ea1\u4e0e\u5a5a\u59fb\u767b\u8bb0\u684c\"},\"\u0442\u043e\u0432\u0430\u0440\u0438\u0449 / \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u043d\":{\"en\":\"comrade / citizen\",\"ja\":\"\u540c\u5fd7 / \u5e02\u6c11\",\"zh\":\"\u540c\u5fd7 / \u516c\u6c11\"},\"\u0442\u0443\u0434\u044b \u0435\u0435 \u0432 \u043a\u0430\u0447\u0435\u043b\u044c\":{\"en\":\"blast it to blazes\",\"ja\":\"\u300c\u3061\u304f\u3057\u3087\u3046\u3081\u300d\",\"zh\":\"\u201c\u771f\u4ed6\u5a18\u7684\u201d\"},\"\u0443\u0438\u0441\u043f\u043e\u043b\u043a\u043e\u043c\u043e\u0432\u0441\u043a\u0438\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0413\u043e\u0441. \u2116 1\":{\"en\":\"the District Executive Committee car, State Plate No. 1\",\"ja\":\"\u90e1\u57f7\u884c\u59d4\u54e1\u4f1a\u306e\u516c\u7528\u8eca\u3001\u5b98\u7528\u30ca\u30f3\u30d0\u30fc1\u53f7\",\"zh\":\"\u53bf\u6267\u59d4\u4f1a\u7684\u56fd\u5bb61\u53f7\u6c7d\u8f66\"},\"\u0443\u043b\u0438\u0446\u0430 \u0438\u043c\u0435\u043d\u0438 \u0442\u043e\u0432\u0430\u0440\u0438\u0449\u0430 \u0413\u0443\u0431\u0435\u0440\u043d\u0441\u043a\u043e\u0433\u043e\":{\"en\":\"Comrade Gubernsky Street\",\"ja\":\"\u30b0\u30d9\u30eb\u30f3\u30b9\u30ad\u30fc\u540c\u5fd7\u901a\u308a\",\"zh\":\"\u53e4\u522b\u5c14\u65af\u57fa\u540c\u5fd7\u5927\u8857\"}}"},"counter":64}